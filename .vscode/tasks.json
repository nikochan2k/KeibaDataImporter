{
  "version": "2.0.0",
  "command": "npm",
  "args": ["run"],
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "problemMatcher": "$tsc",
      "group": {
        "_id": "build",
        "isDefault": false
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "problemMatcher": {
        "owner": "mocha",
        "fileLocation": ["absolute"],
        "pattern": [
          {
            "regexp": "^\\s*\\d+\\)\\s+(.+):$",
            "message": 1
          },
          {
            "regexp": "^\\s+.*$"
          },
          {
            "regexp": "^\\s+.*$"
          },
          {
            "regexp": "^\\s+.*$"
          },
          {
            "regexp": "^\\s+.*$"
          },
          {
            "regexp": "^\\s+.*$"
          },
          {
            "regexp": "\\s+at\\s(.*)\\s\\((.*?:.*?):(\\d+):(\\d+)\\)",
            "file": 2,
            "line": 3,
            "column": 4
          }
        ]
      },
      "group": {
        "_id": "test",
        "isDefault": false
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "npm",
      "args": ["run", "clean", "run"],
      "problemMatcher": []
    }
  ]
}

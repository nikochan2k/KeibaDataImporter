  "description": "Keiba Data Importer",
  "type": "module",
  "main": "src/app/main.ts",
  "scripts": {
    "start": "bun src/app/main.ts",
    "serve": "bun build web/index.html --outdir web/dist --minify --public-path / && bun src/app/server.ts",

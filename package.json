    "@types/encoding-japanese": "^2.4.0",
    "@types/glob": "^9.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tmp": "^0.2.6",
    "@types/unzipper": "^0.10.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",

{
  "name": "keiba-data-importer",
  "version": "0.0.1",
  "description": "Keiba Data Importer",
  "type": "module",
  "main": "src/app/main.ts",
  "scripts": {
    "start": "bun src/app/main.ts",
    "serve": "bun src/app/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "web:build": "bun build web/index.html --outdir web/dist --minify --public-path /",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "repository": {
    "type": "git",
    "url": "git+"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@ttsc/graph": "^0.31.3",
    "@types/bun": "latest",
    "@types/encoding-japanese": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/glob": "^9.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tmp": "^0.2.6",
    "@types/unzipper": "^0.10.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "encoding-japanese": "^2.4.0",
    "glob": "^13.0.6",
    "itaiji-normalize": "^0.2.0",
    "log4js": "^6.9.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tmp": "^0.2.7",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.2",
    "unzipper": "^0.12.5"
  }
}
